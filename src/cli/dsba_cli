# We create a few light wrappers around our platform functionalities, just collect inputs and print the results.


def list_datasets() -> None:
    datasets = list_datasets_ids()
    print("Available datasets:")
    for dataset in datasets:
        print(f"- {dataset}")


def list_models() -> None:
    models = list_models_ids()
    print("Available models:")
    for model in models:
        print(f"- {model}")


def preprocess(dataset_path, target_column, mode):
    dataset = pd.read_csv(dataset_path)
    preprocessed_dataset = preprocess_dataframe(dataset)
    preprocessed_dataset = replace_missing_values(preprocessed_dataset, mode)
    dataset_train, dataset_test = split_dataframe(
        preprocessed_dataset, test_size=0.2)
    os.makedirs("preprocessed_datasets", exist_ok=True)
    os.makedirs(
        f"preprocessed_datasets/{dataset_path.split("/")[1]}/{dataset_path.split("/")[2][:-4]}", exist_ok=True)
    dataset_train.to_csv(
        f"preprocessed_datasets/{dataset_path.split("/")[1]}/{dataset_path.split("/")[2][:-4]}/dataset_train.csv", index=False)
    dataset_test.to_csv(
        f"preprocessed_datasets/{dataset_path.split("/")[1]}/{dataset_path.split("/")[2][:-4]}/dataset_test.csv", index=False)
    return dataset_train, dataset_test


def preprocess_train(dataset_path, target_column, model, mode) -> None:
    dataset_train, dataset_test = preprocess(dataset_path, target_column, mode)
    train(
        f"preprocessed_datasets/{dataset_path.split("/")[1]}/{dataset_path.split("/")[2][:-4]}", target_column, model)


def train(dataset_path, target_column, model) -> None:
    dataset_train = pd.read_csv(f"{dataset_path}/dataset_train.csv")
    dataset_test = pd.read_csv(f"{dataset_path}/dataset_test.csv")
    if model == "all":
        for model in ['xgboost', 'random_forest', 'logistic_regression', 'svm', 'decision_tree']:
            clf, metadata = train_simple_classifier(dataset_train, target_column, str(
                dataset_path.replace("/", "-")[:-4]) + "_" + model, model)
            save_model(clf, metadata)
            model_evaluation = evaluate_classifier(
                clf, target_column, dataset_test)
    else:
        clf, metadata = train_simple_classifier(dataset_train, target_column, str(
            dataset_path.replace("/", "-")[:-4]) + "_" + model, model)
        save_model(clf, metadata)
        model_evaluation = evaluate_classifier(
            clf, target_column, dataset_test)

