def create_parser():
    """
    We use the library argparse to define the functionalities of our CLI,
    it will also do the magic to turn the command line typed by the user into an easy to use python object.

    We want to define a commend line that does
    dsba_cli [command] [options]
    """
    parser = argparse.ArgumentParser(description="DSBA Plaftorm CLI Tool")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # Save dataset command (it requires a dataset name and a file path)
    save_dataset_parser = subparsers.add_parser(
        "save_dataset", help="Save a dataset")
    # automatically saved in csv format so no need to add .csv at the end of the filename
    save_dataset_parser.add_argument(
        "--name", help="Dataset name", required=True)
    save_dataset_parser.add_argument(
        "--new", help="Indicates whether the dataset is new", required=False, action="store_true")
    group = save_dataset_parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--file", help="File path")
    group.add_argument("--url", help="URL path")

    # List models command (it has no additional parameters)
    list_models = subparsers.add_parser(
        "list_models", help="Compare available models")
    list_models.add_argument(
        "--dataset", help="Dataset name", required=True)

    # Compare models command (it has no additional parameters)
    compare_models = subparsers.add_parser(
        "compare_models", help="List available models")
    compare_models.add_argument(
        "--dataset", help="Dataset name", required=True)

    # List local datasets command (it has no additional parameters)
    subparsers.add_parser("list_local_datasets",
                          help="List local available datasets")

    # List S3 datasets command (it has no additional parameters)
    subparsers.add_parser("list_s3_datasets",
                          help="List S3 available datasets")

    # List S3 dataset versions command (it has no additional parameters)
    list_s3_dataset_versions_parser = subparsers.add_parser(
        "list_s3_dataset_versions", help="List S3 available dataset versions")
    list_s3_dataset_versions_parser.add_argument(
        "--dataset", help="Dataset name", required=True)

    # Download dataset from S3 command (it requires a dataset name)
    download_dataset_from_S3_parser = subparsers.add_parser(
        "download_dataset_from_S3", help="Download dataset from S3")
    download_dataset_from_S3_parser.add_argument(
        "--s3_filename", help="S3 filename", required=True)

    # List dataset versions command (it requires a dataset name)
    list_dataset_versions_parser = subparsers.add_parser(
        "list_dataset_versions", help="List dataset versions")
    list_dataset_versions_parser.add_argument(
        "--dataset", help="Dataset name", required=True)

    # Preprocess command (it requires a dataset name and a target column)
    preprocess_parser = subparsers.add_parser(
        "preprocess", help="Preprocess a dataset")
    preprocess_parser.add_argument(
        "--dataset", help="Dataset name", required=True)
    preprocess_parser.add_argument(
        "--target", help="Target column", required=True)
    preprocess_parser.add_argument(
        "--mode", help="Mode to replace missing values", required=True)
    preprocess_parser.add_argument(
        "--useless", help="List of columns to drop (space-separated values)", nargs="+", required=False, default=[]
    )

    # Preprocess and train a model
    preprocess_train_parser = subparsers.add_parser(
        "preprocess_and_train", help="Preprocess then train a model")
    preprocess_train_parser.add_argument(
        "--dataset", help="Dataset name", required=True)
    preprocess_train_parser.add_argument(
        "--target", help="Target column", required=True)
    preprocess_train_parser.add_argument(
        "--model", help="Model name", required=True)
    preprocess_train_parser.add_argument(
        "--mode", help="Mode to replace missing values", required=True)
    preprocess_train_parser.add_argument(
        "--useless", help="List of columns to drop (space-separated values)", nargs="+", required=False, default=[]
    )
    preprocess_train_parser.add_argument(
        "--gridsearch", help="Indicates whether GridSearch should be used or not", required=False, action="store_true")

    # Train a model
    train_parser = subparsers.add_parser("train", help="Train a model")
    train_parser.add_argument("--dataset", help="Dataset name", required=True)
    train_parser.add_argument("--target", help="Target column", required=True)
    train_parser.add_argument("--model", help="Model name", required=True)
    train_parser.add_argument(
        "--gridsearch", help="Indicates whether GridSearch should be used or not", required=False, action="store_true")

    # Find best model command (it requires a dataset name and a target column)
    find_best_model_parser = subparsers.add_parser(
        "find_best_model", help="Find the best model")
    find_best_model_parser.add_argument(
        "--dataset", help="Dataset name", required=True)
    find_best_model_parser.add_argument(
        "--metric", help="Metric to use", default="f1_score", required=False)

    # Predict command (it requires a model name, an input file and an output file)
    predict_parser = subparsers.add_parser("predict", help="Make predictions")
    predict_parser.add_argument(
        "--model", help="Model name to use", required=True)
    predict_parser.add_argument(
        "--input", help="Input file path", required=True)
    predict_parser.add_argument(
        "--output", help="Output file path", required=True)

    # Predict with best model command (it requires a model name, an input file and an output file)
    predict_with_bm_parser = subparsers.add_parser(
        "predict_with_best_model", help="Make predictions using the best model")
    predict_with_bm_parser.add_argument(
        "--folder", help="Folder name", required=True)
    predict_with_bm_parser.add_argument(
        "--input", help="Input file path", required=True)
    predict_with_bm_parser.add_argument(
        "--output", help="Output file path", required=True)
    predict_with_bm_parser.add_argument(
        "--metric", help="Metric to use", default="f1_score", required=False)

    # Build image command
    subparsers.add_parser("build_image", help="Build the FastAPI image")

    # Run container command
    subparsers.add_parser("run_container", help="Run the FastAPI container")

    # Create ECR repository command
    create_ecr_repo_parser = subparsers.add_parser("create_ecr_repository",
                                                   help="Create an ECR repository")
    create_ecr_repo_parser.add_argument(
        "--repository-name", help="Repository name", required=True)

    # Tag and push image command
    tag_and_push_image_parser = subparsers.add_parser("tag_and_push_image",
                                                      help="Tag and push the image to ECR")
    tag_and_push_image_parser.add_argument(
        "--repository-uri", help="Repository URI", required=True)

    # Deploy from ECR to App Runner command
    deploy_from_ecr_to_app_runner_parser = subparsers.add_parser("deploy_from_ecr_to_app_runner",
                                                                 help="Deploy from ECR to App Runner")
    deploy_from_ecr_to_app_runner_parser.add_argument(
        "--service-name", help="Service name", required=True)
    deploy_from_ecr_to_app_runner_parser.add_argument(
        "--image-identifier", help="Image identifier", required=True)

    return parser


def get_script_args():
    parser = create_parser()
    return parser.parse_args()


def main():
    args = get_script_args()
    if args.command == "save_dataset":
        if args.file:
            print(f"Saving dataset {args.name} from file {args.file}")
            save_dataset(args.name, args.file, args.new)
        elif args.url:
            print(f"Saving dataset {args.name} from url {args.url}")
            save_dataset(args.name, args.url, args.new)
    elif args.command == "list_local_datasets":
        list_local_datasets()
    elif args.command == "list_s3_datasets":
        list_s3_datasets()
    elif args.command == "list_s3_dataset_versions":
        list_s3_dataset_versions(args.dataset)
    elif args.command == "download_dataset_from_S3":
        download_dataset_from_S3(args.s3_filename)
    elif args.command == "list_dataset_versions":
        list_dataset_versions(args.dataset)
    elif args.command == "list_models":
        list_models(args.dataset)
    elif args.command == "compare_models":
        compare_models(args.dataset)
    elif args.command == "preprocess":
        preprocess(args.dataset, args.target, args.mode, args.useless)
    elif args.command == "preprocess_and_train":
        preprocess_train(args.dataset, args.target,
                         args.model, args.mode, args.useless, args.gridsearch)
    elif args.command == "train":
        train(args.dataset, args.target, args.model, args.gridsearch)
    elif args.command == "find_best_model":
        find_best_model(args.dataset, args.metric)
    elif args.command == "predict":
        predict(args.model, args.input, args.output)
    elif args.command == "predict_with_best_model":
        predict_with_best_model(args.folder, args.input,
                                args.output, args.metric)
    elif args.command == "build_image":
        build_image()
    elif args.command == "run_container":
        run_container()
    elif args.command == "create_ecr_repository":
        create_ecr_repository(args.repository_name)
    elif args.command == "tag_and_push_image":
        tag_and_push_image(args.repository_uri)
    elif args.command == "deploy_from_ecr_to_app_runner":
        deploy_from_ecr_to_app_runner(args.service_name, args.image_identifier)
    else:
        print("Unknown command")

