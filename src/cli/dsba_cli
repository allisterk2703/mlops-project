def preprocess(dataset_path: str, target_column: str, mode: str, useless: list):
    print(useless)
    dataset = pd.read_csv(f"datas/{dataset_path}")
    preprocessed_dataset = preprocess_dataframe(dataset)
    preprocessed_dataset = replace_missing_values(preprocessed_dataset, mode)
    preprocessed_dataset = preprocessed_dataset.drop(
        columns=useless)
    dataset_train, dataset_test = split_dataframe(
        preprocessed_dataset, test_size=0.2)
    os.makedirs("preprocessed_datasets", exist_ok=True)
    os.makedirs(
        f"preprocessed_datasets/{dataset_path.split("/")[0]}/{dataset_path.split("/")[1][:-4]}", exist_ok=True)
    dataset_train.to_csv(
        f"preprocessed_datasets/{dataset_path.split("/")[0]}/{dataset_path.split("/")[1][:-4]}/dataset_train.csv", index=False)
    dataset_test.to_csv(
        f"preprocessed_datasets/{dataset_path.split("/")[0]}/{dataset_path.split("/")[1][:-4]}/dataset_test.csv", index=False)

    with open(f"models/{dataset_path.split('/')[0]}/useful_columns.txt", "w") as f:
        col_name = preprocessed_dataset.columns.to_list()
        col_type = preprocessed_dataset.dtypes.to_list()
        for col, type in zip(col_name, col_type):
            f.write(f"{col} : {type}\n")

    return dataset_train, dataset_test


def preprocess_train(dataset_path, target_column, model, mode) -> None:
    dataset_train, dataset_test = preprocess(dataset_path, target_column, mode)
    train(
        f"preprocessed_datasets/{dataset_path.split("/")[0]}/{dataset_path.split("/")[1]}", target_column, model)


def train(dataset_path, target_column, model, gridsearch=False) -> None:
    dataset_train = pd.read_csv(f"{dataset_path}/dataset_train.csv")
    dataset_test = pd.read_csv(f"{dataset_path}/dataset_test.csv")
    if model == "all":
        for model in ['xgboost', 'random_forest', 'logistic_regression', 'svm', 'decision_tree']:
            clf, metadata = train_simple_classifier(dataset_train, target_column, str(
                dataset_path.replace("/", "-")) + "_" + model, model, gridsearch)
            model_evaluation = evaluate_classifier(
                clf, target_column, dataset_test)
            # print(clf, metadata, model_evaluation)
            save_model(clf, metadata, model_evaluation)
    else:
        clf, metadata = train_simple_classifier(dataset_train, target_column, str(
            dataset_path.replace("/", "-")) + "_" + model, model, gridsearch)
        model_evaluation = evaluate_classifier(
            clf, target_column, dataset_test)
        save_model(clf, metadata, model_evaluation)


def extract_metrics_to_csv(json_folder, output_csv):
    metrics_list = []

    for file in os.listdir(json_folder):
        if file.endswith(".json"):
            file_path = os.path.join(json_folder, file)

            with open(file_path, "r") as f:
                data = json.load(f)
                model_name = data.get("algorithm", "unknown")
                dataset = data.get("id", "unknown").replace(
                    "preprocessed_datasets-", "")
                accuracy = data["performance_metrics"].get("accuracy", None)
                precision = data["performance_metrics"].get("precision", None)
                recall = data["performance_metrics"].get("recall", None)
                f1_score = data["performance_metrics"].get("f1_score", None)
                gridsearch = data.get("gridsearch", False)

                metrics_list.append({
                    "model": model_name,
                    "dataset": dataset,
                    "accuracy": accuracy,
                    "precision": precision,
                    "recall": recall,
                    "f1_score": f1_score,
                    "gridsearch": gridsearch
                })
    df = pd.DataFrame(metrics_list)
    df.to_csv(output_csv, index=False)
    logging.info(f"Metrics saved to {output_csv}")

    return df


def find_best_model(dataset, metric):
    metrics_csv_path = f"models/{dataset}/metrics.csv"
    df = extract_metrics_to_csv(f"models/{dataset}", metrics_csv_path)

    best_model_row = df.sort_values(by=metric, ascending=False).iloc[0]
    best_model = best_model_row["model"]
    gridsearch = best_model_row["gridsearch"]
    trained_on = str(best_model_row["dataset"])[
        len(dataset)+1:-len(best_model)-1] + ".csv"

    print(
        f"Best model is: {best_model} trained on {trained_on} with {metric} = {best_model_row[metric]:.4f}")
    with open(f"models/{dataset}/best_model.txt", "w") as f:
        f.write(best_model + "\n" + str(gridsearch) + "\n" + trained_on)

    return best_model


def get_best_model(dataset, metric):
    with open(f"models/{dataset}/best_model.txt", "r") as f:
        lines = f.readlines()
    best_model = lines[0].strip()
    trained_on = lines[1].strip()[:-4]
    pickle = f"{dataset}/{trained_on}_{best_model}"
    return pickle


def predict(model_id: str, input_file: str, output_file: str) -> None:
    if model_id.endswith("_gs"):
        gridsearch = True
    else:
        gridsearch = False

    model = load_model(model_id, gridsearch)
    metadata = load_model_metadata(model_id, gridsearch)
    df = load_csv_from_path(input_file)
    predictions = classify_dataframe(model, df, metadata.target_column)
    write_csv_to_path(predictions, output_file)
    print(f"Scored {len(predictions)} records")


def predict_with_best_model(folder: str, input_file: str, output_file: str, metric: str) -> None:
    best_model_id = get_best_model(folder, metric="f1_score")
    if best_model_id.endswith("_gs"):
        gridsearch = True
    else:
        gridsearch = False
    model = load_model(best_model_id, gridsearch)
    metadata = load_model_metadata(best_model_id)
    df = load_csv_from_path(input_file)
    predictions = classify_dataframe(model, df, metadata.target_column)
    write_csv_to_path(predictions, output_file)
    print(f"Scored {len(predictions)} records")


def build_image():
    os.system("docker build -t fastapi-app -f src/api/Dockerfile .")


def run_container():
    DSBA_MODELS_ROOT_PATH = os.getenv("DSBA_MODELS_ROOT_PATH")
    # print(DSBA_MODELS_ROOT_PATH)
    os.system(
        f"docker run -d -p 8000:8000 --name fastapi-container -v '{DSBA_MODELS_ROOT_PATH}:/app/models' -e DSBA_MODELS_ROOT_PATH='/app/models' --env-file .env fastapi-app")


def create_ecr_repository(repository_name="mlops-app-runner"):
    os.system(
        f"aws ecr create-repository --repository-name {repository_name} --region eu-west-3")
    repository_uri = subprocess.getoutput(
        f"aws ecr describe-repositories --repository-names {repository_name} --region eu-west-3 --query 'repositories[0].repositoryUri' --output text")
    print(f"Repository URI: {repository_uri}")


def tag_and_push_image(repository_uri):
    os.system(f"docker tag fastapi-app {repository_uri}:latest")
    os.system(
        f"aws ecr get-login-password --region eu-west-3 | docker login --username AWS --password-stdin {repository_uri}")
    os.system(f"docker push {repository_uri}:latest")


def deploy_from_ecr_to_app_runner(image_identifier, service_name="mlops-app-runner"):
    role_arn = subprocess.getoutput(
        "aws sts get-caller-identity --query 'Arn' --output text")

    source_config = {
        "AuthenticationConfiguration": {
            "AccessRoleArn": role_arn
        },
        "ImageRepository": {
            "ImageIdentifier": image_identifier,
            "ImageRepositoryType": "ECR",
            "ImageConfiguration": {
                "Port": "8000",
                "RuntimeEnvironmentVariables": {
                    "DSBA_MODELS_ROOT_PATH": "/app/models"
                }
            }
        },
        "AutoDeployments": True
    }

    command = [
        "aws", "apprunner", "create-service",
        "--service-name", service_name,
        "--region eu-west-3",
        "--profile MyIAMUser",
        "--source-configuration", json.dumps(source_config)
    ]

    subprocess.run(command, check=True)


