def create_parser():
    """
    We use the library argparse to define the functionalities of our CLI,
    it will also do the magic to turn the command line typed by the user into an easy to use python object.

    We want to define a commend line that does
    dsba_cli [command] [options]
    """
    parser = argparse.ArgumentParser(description="DSBA Plaftorm CLI Tool")
    subparsers = parser.add_subparsers(dest="command", required=True)

    # Save dataset command (it requires a dataset name and a file path)
    save_dataset_parser = subparsers.add_parser(
        "save_dataset", help="Save a dataset")
    # automatically saved in csv format so no need to add .csv at the end of the filename
    save_dataset_parser.add_argument(
        "--name", help="Dataset name", required=True)
    save_dataset_parser.add_argument(
        "--new", action="store_true", help="Indicates whether the dataset is new")
    group = save_dataset_parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--file", help="File path")
    group.add_argument("--url", help="URL path")

    # List models command (it has no additional parameters)
    subparsers.add_parser("list_models", help="List available models")

    # List datasets command (it has no additional parameters)
    subparsers.add_parser("list_datasets", help="List available datasets")

    # List dataset versions command (it requires a dataset name)
    list_dataset_versions_parser = subparsers.add_parser(
        "list_dataset_versions", help="List dataset versions")
    list_dataset_versions_parser.add_argument(
        "--dataset", help="Dataset name", required=True)

    # Preprocess command (it requires a dataset name and a target column)
    preprocess_parser = subparsers.add_parser(
        "preprocess", help="Preprocess a dataset")
    preprocess_parser.add_argument(
        "--dataset", help="Dataset name", required=True)
    preprocess_parser.add_argument(
        "--target", help="Target column", required=True)
    preprocess_parser.add_argument(
        "--mode", help="Mode to replace missing values", required=True)

    # Traing a model
    preprocess_train_parser = subparsers.add_parser(
        "preprocess_and_train", help="Preprocess then train a model")
    preprocess_train_parser.add_argument(
        "--dataset", help="Dataset name", required=True)
    preprocess_train_parser.add_argument(
        "--target", help="Target column", required=True)
    preprocess_train_parser.add_argument(
        "--model", help="Model name", required=True)
    preprocess_train_parser.add_argument(
        "--mode", help="Mode to replace missing values", required=True)

    # Traing a model
    train_parser = subparsers.add_parser("train", help="Train a model")
    train_parser.add_argument("--dataset", help="Dataset name", required=True)
    train_parser.add_argument("--target", help="Target column", required=True)
    train_parser.add_argument("--model", help="Model name", required=True)

    # Find best model command (it requires a dataset name and a target column)
    find_best_model_parser = subparsers.add_parser(
        "find_best_model", help="Find the best model")
    find_best_model_parser.add_argument(
        "--dataset", help="Dataset name", required=True)
    find_best_model_parser.add_argument(
        "--target", help="Target column", required=True)

    # Predict command (it requires a model name, an input file and an output file)
    predict_parser = subparsers.add_parser("predict", help="Make predictions")
    predict_parser.add_argument(
        "--model", help="Model name to use", required=True)
    predict_parser.add_argument(
        "--input", help="Input file path", required=True)
    predict_parser.add_argument(
        "--output", help="Output file path", required=True)

    return parser


def get_script_args():
    parser = create_parser()
    return parser.parse_args()


def main():
    args = get_script_args()
    if args.command == "save_dataset":
        if args.file:
            print(f"Saving dataset {args.name} from file {args.file}")
            save_dataset(args.name, args.file, args.new)
        elif args.url:
            print(f"Saving dataset {args.name} from url {args.url}")
            save_dataset(args.name, args.url, args.new)
    elif args.command == "list_datasets":
        list_datasets()
    elif args.command == "list_dataset_versions":
        list_dataset_versions(args.dataset)
    elif args.command == "list_models":
        list_models()
    elif args.command == "preprocess":
        preprocess(args.dataset, args.target, args.mode)
    elif args.command == "preprocess_and_train":
        preprocess_train(args.dataset, args.target, args.model, args.mode)
    elif args.command == "train":
        train(args.dataset, args.target, args.model)
    elif args.command == "find_best_model":
        find_best_model(args.dataset, args.target)
    elif args.command == "predict":
        predict(args.model, args.input, args.output)

