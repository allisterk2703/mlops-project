def list_local_datasets() -> None:
    datasets = list_datasets_ids()
    print("Available datasets:")
    for dataset in datasets:
        print(f"- {dataset}")


def list_s3_datasets() -> None:
    s3_client = boto3.client("s3", aws_access_key_id=AWS_ACCESS_KEY,
                             aws_secret_access_key=AWS_SECRET_KEY, region_name=AWS_REGION)
    response = s3_client.list_objects_v2(Bucket=S3_BUCKET_NAME)

    if "Contents" in response:
        print("Available datasets in S3:")
        for obj in response["Contents"]:
            print("-", obj["Key"])  # Affiche le nom du fichier
    else:
        print("Erreur")


def list_s3_dataset_versions(dataset) -> None:
    s3_client = boto3.client("s3", aws_access_key_id=AWS_ACCESS_KEY,
                             aws_secret_access_key=AWS_SECRET_KEY, region_name=AWS_REGION)
    response = s3_client.list_objects_v2(Bucket=S3_BUCKET_NAME)

    if "Contents" in response:
        dataset_files = [obj["Key"] for obj in response["Contents"]
                         if obj["Key"].split("/")[0] == dataset]

        if dataset_files:
            print(f"Available versions for dataset '{dataset}':")
            for file in dataset_files:
                print("-", file)  # Affiche le chemin complet du fichier
        else:
            print(f"No versions found for dataset '{dataset}'.")
    else:
        print("Erreur")


def download_dataset_from_S3(s3_filename) -> None:
    s3_client = boto3.client("s3", aws_access_key_id=AWS_ACCESS_KEY,
                             aws_secret_access_key=AWS_SECRET_KEY, region_name=AWS_REGION)
    local_path = f"datas/{s3_filename}"
    folder = s3_filename.split("/")[0]
    os.makedirs(f"datas/{folder}", exist_ok=True)
    try:
        response = s3_client.get_object(Bucket=S3_BUCKET_NAME, Key=s3_filename)
        file_bytes = response['Body'].read()
        print("ZIP successfully downloaded")
        zip_local_path = local_path.replace(".csv", ".zip")
        with open(zip_local_path, "wb") as f:
            f.write(file_bytes)
        with zipfile.ZipFile(BytesIO(file_bytes), 'r') as zip_ref:
            extracted_files = zip_ref.namelist()
            zip_ref.extractall(os.path.dirname(local_path))
        extracted_file_path = os.path.join(
            os.path.dirname(local_path), extracted_files[0])
        zip_filename = os.path.splitext(os.path.basename(zip_local_path))[0]
        extracted_extension = os.path.splitext(extracted_file_path)[1]
        new_file_path = os.path.join(os.path.dirname(
            local_path), f"{zip_filename}{extracted_extension}")
        os.rename(extracted_file_path, new_file_path)
        os.remove(zip_local_path)
        print(f"CSV extracted and renamed to: {new_file_path}")
    except Exception as e:
        print(f"Error downloading {s3_filename} from S3: {e}")


